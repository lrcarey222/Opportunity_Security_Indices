ly","path":"partners.ITA.name","claim":"c165","src":1},{"t":"text","v":" and "},{"t":"value","v":"France","path":"partners.FRA.name","claim":"c166","src":1},{"t":"text","v":" each as an "},{"t":"value","v":"export market","path":"partners.ITA.reason","claim":"c167","src":1},{"t":"text","v":"."}],"refs":[1]},{"type":"p","inlines":[{"t":"text","v":"The "},{"t":"value","v":"United States","path":"partners.USA.name","claim":"c168","src":1},{"t":"text","v":" is also its "},{"t":"value","v":"1st","path":"partners.USA.ties.tie_rank","claim":"c169","src":5},{"t":"text","v":" trade partner on average across its energy-goods baskets, "},{"t":"value","v":"France","path":"partners.FRA.name","claim":"c170","src":1},{"t":"text","v":" its "},{"t":"value","v":"3rd","path":"partners.FRA.ties.tie_rank","claim":"c171","src":5},{"t":"text","v":" and "},{"t":"value","v":"Italy","path":"partners.ITA.name","claim":"c172","src":1},{"t":"text","v":" its "},{"t":"value","v":"4th","path":"partners.ITA.ties.tie_rank","claim":"c173","src":5},{"t":"text","v":"; each is "},{"t":"value","v":"a priority partner with strong ties today","path":"partners.USA.match","claim":"c174","src":1},{"t":"text","v":". Germany and the "},{"t":"value","v":"United States","path":"partners.USA.name","claim":"c175","src":1},{"t":"text","v":" both belong to "},{"t":"value","v":"the G7, NATO and the Minerals Security Partnership","path":"partners.USA.ties.agreements|list","claim":"c176","src":10},{"t":"text","v":". "},{"t":"value","v":"Austria","path":"partners.AUT.name","claim":"c179","src":1},{"t":"text","v":" and the "},{"t":"value","v":"Czech Republic","path":"partners.CZE.name","claim":"c180","src":1},{"t":"text","v":" rank lower as trade partners, at "},{"t":"value","v":"9th","path":"partners.AUT.ties.tie_rank","claim":"c181","src":5},{"t":"text","v":" and "},{"t":"value","v":"11th","path":"partners.CZE.ties.tie_rank","claim":"c182","src":5},{"t":"text","v":"."}],"refs":[1,5,10]},{"type":"p","inlines":[{"t":"value","v":"China","path":"partners.CHN.name","claim":"c183","src":1},{"t":"text","v":" is its "},{"t":"value","v":"2nd","path":"partners.CHN.ties.tie_rank","claim":"c184","src":5},{"t":"text","v":" trade partner, but the index ranks it "},{"t":"value","v":"51st","path":"partners.CHN.rank","claim":"c185","src":1},{"t":"text","v":": it is "},{"t":"value","v":"a strong tie today that the index ranks lower","path":"partners.CHN.match","claim":"c186","src":1},{"t":"text","v":". On the index it counts as a "},{"t":"value","v":"development partner","path":"partners.CHN.reason","claim":"c187","src":1},{"t":"text","v":", and in votes at the United Nations, Germany and "},{"t":"value","v":"China","path":"partners.CHN.name","claim":"c188","src":1},{"t":"text","v":" sit in "},{"t":"value","v":"opposite blocs","path":"partners.CHN.ties.alignment_d","claim":"c189","src":11},{"t":"text","v":"."}],"refs":[1,5,11]},{"type":"p","inlines":[{"t":"text","v":"As a partner to the coalition, Germany ranks "},{"t":"value","v":"2nd","path":"summary.as_partner.rank","claim":"c190","src":1},{"t":"text","v":" of "},{"t":"value","v":"192","path":"summary.as_partner.n","claim":"c191","src":1},{"t":"text","v":" economies. In the allied network design, its derived shares of coalition production are largest in "},{"t":"value","v":"midstream nuclear","path":"network.producer.0.cell","claim":"c192","src":8},{"t":"text","v":" ("},{"t":"value","v":"5.4%","path":"network.producer.0.share","claim":"c193","src":8},{"t":"text","v":") and "},{"t":"value","v":"midstream green hydrogen","path":"network.producer.1.cell","claim":"c194","src":8},{"t":"text","v":" ("},{"t":"value","v":"5.1%","path":"network.producer.1.share","claim":"c195","src":8},{"t":"text","v":")."}],"refs":[1,8]}]},{"n":5,"title":"Data notes and caveats","blocks":[{"type":"p","inlines":[{"t":"text","v":"See the Country Insights page ("},{"t":"value","v":"12 October 2026","path":"meta.as_of_label","claim":"c196","src":null},{"t":"text","v":" baseline) for each source."}],"refs":[]},{"type":"ul","items":[{"inlines":[{"t":"value","v":"Scores compare Germany with other economies in the same sector; they are not measures of risk or profit in absolute terms.","path":"caveats.relative_scores","claim":"c197","src":null}],"refs":[]},{"inlines":[{"t":"value","v":"All index values are the paper's baseline as of 12 October 2026; Strategic Insights recomputes them under other weightings.","path":"caveats.baseline","claim":"c198","src":null}],"refs":[]},{"inlines":[{"t":"value","v":"Some figures behind these scores are filled in where the source has no value: with zero where a source lists every holder, otherwise with the world average.","path":"caveats.imputed_driver","claim":"c199","src":null}],"refs":[]},{"inlines":[{"t":"value","v":"Strategic Index scores within 0.01 of each other are almost tied: small changes in the data or the weights can swap their order.","path":"caveats.near_tie","claim":"c200","src":null}],"refs":[]},{"inlines":[{"t":"value","v":"Many allied picks are close calls: in the paper, 37% of them are within 0.01 of the runner-up.","path":"caveats.pick_stability","claim":"c201","src":null}],"refs":[]},{"inlines":[{"t":"value","v":"In the allied network design the European Union is one producer; Germany's shares are derived from its weight within the EU.","path":"caveats.eu_node","claim":"c202","src":null}],"refs":[]},{"inlines":[{"t":"value","v":"Trade figures count trade with other EU members.","path":"caveats.intra_eu","claim":"c203","src":null}],"refs":[]},{"inlines":[{"t":"value","v":"Germany's counts leave out the EU's own 438 International Energy Agency policy records.","path":"caveats.eu_policy_records","claim":"c204","src":null}],"refs":[]}]}]}],"sources":[{"n":1,"id":"osi_indices","text":"Energy Security, Economic Opportunity, Strategic Index and Partnership Strength Index, paper baseline (Opportunity Security Indices pipeline); CC BY 4.0 (the paper's indices)."},{"n":2,"id":"iea_pams","text":"International Energy Agency, Policies and Measures Database (export of 2026-09-30); attribution; https://www.iea.org/policies."},{"n":3,"id":"ei","text":"Energy Institute, Statistical Review of World Energy 2026 (data to 2025); attribution; https://www.energyinst.org/statistical-review."},{"n":4,"id":"eia_intl","text":"U.S. Energy Information Administration, International Energy Statistics, bulk file INTL.zip: crude oil incl. lease condensate, NGPL, dry natural gas and coal production; petroleum and other liquids, dry natural gas and coal consumption, bulk file dated 2026-10-03 (oil production to 2025; gas and coal to 2024); open; https://www.eia.gov/international/data/world."},{"n":5,"id":"comtrade_matrix","text":"United Nations, UN Comtrade Database, HS6 bilateral trade (all reporters), 2020 and 2024; reconciled by the authors (pulled 2026-10-07 to 2026-10-09); attribution; https://comtradeplus.un.org/."},{"n":6,"id":"comtrade_reported","text":"United Nations, UN Comtrade Database, exports to World by reporter, 2024 (2024 data); attribution; https://comtradeplus.un.org/."},{"n":7,"id":"atlas","text":"Growth Lab at Harvard University, The Atlas of Economic Complexity, HS92 6-digit country-product-year data (data to 2023); attribution; https://atlas.hks.harvard.edu/."},{"n":8,"id":"network","text":"Allied network design (the paper's model design of coalition production shares)."},{"n":9,"id":"cat","text":"Climate Action Tracker, country ratings (ratings updated 2022-2025); attribution; https://climateactiontracker.org/."},{"n":10,"id":"agreements","text":"Economic-security agreements: G7, NATO, Indo-Pacific Economic Framework, Minerals Security Partnership (and Forum), U.S. free-trade agreements (compiled by the authors from official membership lists)."},{"n":11,"id":"un_votes","text":"Bailey, M., Strezhnev, A. and Voeten, E., United Nations General Assembly Voting Data, ideal points (Harvard Dataverse V39.0) (sessions to 2023); attribution; https://dataverse.har