rtners.ESP.reason","claim":"c153","src":1},{"t":"text","v":" strongest in "},{"t":"value","v":"midstream wind, upstream solar, midstream solar, midstream electric vehicles and upstream electric grid","path":"partners.ESP.fs_best5|list","claim":"c154","src":1},{"t":"text","v":". The index combines how reliable a supplier a partner is (Friendshore), how good a market it is (Partnership Opportunity) and, for lower-income partners, Development Potential. The "},{"t":"value","v":"Netherlands","path":"partners.NLD.name","claim":"c159","src":1},{"t":"text","v":" ranks "},{"t":"value","v":"2nd","path":"partners.NLD.rank","claim":"c160","src":1},{"t":"text","v":", also as a "},{"t":"value","v":"reliable supplier","path":"partners.NLD.reason","claim":"c161","src":1},{"t":"text","v":", followed by "},{"t":"value","v":"France","path":"partners.FRA.name","claim":"c162","src":1},{"t":"text","v":" ("},{"t":"value","v":"3rd","path":"partners.FRA.rank","claim":"c163","src":1},{"t":"text","v":", "},{"t":"value","v":"export market","path":"partners.FRA.reason","claim":"c164","src":1},{"t":"text","v":") and "},{"t":"value","v":"Germany","path":"partners.DEU.name","claim":"c165","src":1},{"t":"text","v":" ("},{"t":"value","v":"4th","path":"partners.DEU.rank","claim":"c166","src":1},{"t":"text","v":", "},{"t":"value","v":"export market","path":"partners.DEU.reason","claim":"c167","src":1},{"t":"text","v":")."}],"refs":[1]},{"type":"p","inlines":[{"t":"text","v":"Today's ties match these ranks in part. "},{"t":"value","v":"Spain","path":"partners.ESP.name","claim":"c168","src":1},{"t":"text","v":", "},{"t":"value","v":"France","path":"partners.FRA.name","claim":"c169","src":1},{"t":"text","v":" and "},{"t":"value","v":"Germany","path":"partners.DEU.name","claim":"c170","src":1},{"t":"text","v":" are its "},{"t":"value","v":"1st","path":"partners.ESP.ties.tie_rank","claim":"c171","src":3},{"t":"text","v":", "},{"t":"value","v":"3rd","path":"partners.FRA.ties.tie_rank","claim":"c172","src":3},{"t":"text","v":" and "},{"t":"value","v":"4th","path":"partners.DEU.ties.tie_rank","claim":"c173","src":3},{"t":"text","v":" trade partners on average across its energy-goods baskets. The "},{"t":"value","v":"Netherlands","path":"partners.NLD.name","claim":"c174","src":1},{"t":"text","v":", by contrast, is only its "},{"t":"value","v":"12th","path":"partners.NLD.ties.tie_rank","claim":"c175","src":3},{"t":"text","v":". Conversely, "},{"t":"value","v":"China","path":"partners.CHN.name","claim":"c176","src":1},{"t":"text","v":" is its "},{"t":"value","v":"2nd","path":"partners.CHN.ties.tie_rank","claim":"c177","src":3},{"t":"text","v":" trade partner, yet ranks "},{"t":"value","v":"65th","path":"partners.CHN.rank","claim":"c178","src":1},{"t":"text","v":" on Partnership Strength and rates best as a "},{"t":"value","v":"development partner","path":"partners.CHN.reason","claim":"c179","src":1},{"t":"text","v":". "},{"t":"value","v":"Spain","path":"partners.ESP.name","claim":"c180","src":1},{"t":"text","v":", the "},{"t":"value","v":"Netherlands","path":"partners.NLD.name","claim":"c181","src":1},{"t":"text","v":", "},{"t":"value","v":"France","path":"partners.FRA.name","claim":"c182","src":1},{"t":"text","v":" and "},{"t":"value","v":"Germany","path":"partners.DEU.name","claim":"c183","src":1},{"t":"text","v":" each share "},{"t":"value","v":"NATO","path":"partners.ESP.ties.agreements|list","claim":"c184","src":9},{"t":"text","v":" membership with "},{"t":"value","v":"Portugal","path":"meta.country","claim":"c185","src":null},{"t":"text","v":" and vote in the "},{"t":"value","v":"same bloc","path":"partners.ESP.ties.alignment_d","claim":"c186","src":10},{"t":"text","v":" at the United Nations. "},{"t":"value","v":"China","path":"partners.CHN.name","claim":"c187","src":1},{"t":"text","v":" shares none of its economic-security agreements, and their votes put them in "},{"t":"value","v":"opposite blocs","path":"partners.CHN.ties.alignment_d","claim":"c188","src":10},{"t":"text","v":"."}],"refs":[1,3,9,10]},{"type":"p","inlines":[{"t":"text","v":"As a partner to the coalition, "},{"t":"value","v":"Portugal","path":"meta.country","claim":"c189","src":null},{"t":"text","v":" ranks "},{"t":"value","v":"16th","path":"summary.as_partner.rank","claim":"c190","src":1},{"t":"text","v":" of "},{"t":"value","v":"192","path":"summary.as_partner.n","claim":"c191","src":1},{"t":"text","v":" economies on Partnership Strength averaged over the core members' viewpoints. In the allied network design its shares are derived from the European Union's: they are largest in "},{"t":"value","v":"midstream green hydrogen","path":"network.producer.0.cell","claim":"c192","src":7},{"t":"text","v":" ("},{"t":"value","v":"0.4%","path":"network.producer.0.share","claim":"c193","src":7},{"t":"text","v":" of designed coalition production) and "},{"t":"value","v":"midstream wind","path":"network.producer.1.cell","claim":"c194","src":7},{"t":"text","v":" ("},{"t":"value","v":"0.3%","path":"network.producer.1.share","claim":"c195","src":7},{"t":"text","v":")."}],"refs":[1,7]}]},{"n":5,"title":"Data notes and caveats","blocks":[{"type":"p","inlines":[{"t":"text","v":"Figures are as of "},{"t":"value","v":"12 October 2026","path":"meta.as_of_label","claim":"c196","src":null},{"t":"text","v":". "},{"t":"value","v":"Scores compare Portugal with other economies in the same sector; they are not measures of risk or profit in absolute terms.","path":"caveats.relative_scores","claim":"c197","src":null},{"t":"text","v":" "},{"t":"value","v":"All index values are the paper's baseline as of 12 October 2026; Strategic Insights recomputes them under other weightings.","path":"caveats.baseline","claim":"c198","src":null},{"t":"text","v":" "},{"t":"value","v":"Some figures behind these scores are filled in where the source has no value: with zero where a source lists every holder, otherwise with the world average.","path":"caveats.imputed_driver","claim":"c199","src":null},{"t":"text","v":" "},{"t":"value","v":"Strategic Index scores within 0.01 of each other are almost tied: small changes in the data or the weights can swap their order.","path":"caveats.near_tie","claim":"c200","src":null},{"t":"text","v":" "},{"t":"value","v":"Many allied picks are close calls: in the paper, 37% of them are within 0.01 of the runner-up.","path":"caveats.pick_stability","claim":"c201","src":null},{"t":"text","v":" "},{"t":"value","v":"In the allied network design the European Union is one producer; Portugal's shares are derived from its weight within the EU.","path":"caveats.eu_node","claim":"c202","src":null},{"t":"text","v":" "},{"t":"value","v":"The Climate Action Tracker rates the EU as a whole; Portugal carries the EU's rating.","path":"caveats.cat_eu_bloc","claim":"c203","src":null},{"t":"text","v":" "},{"t":"value","v":"Portugal's counts leave out the EU's own 438 International Energy Agency policy records.","path":"caveats.eu_policy_records","claim":"c204","src":null},{"t":"text","v":" "},{"t":"value","v":"Trade figures count trade with other EU members.","path":"caveats.intra_eu","claim":"c205","src":null}],"refs":[]}]}],"sources":[{"n":1,"id":"osi_indices","text":"Energy Security, Economic Opportunity, Strategic Index and Partnership Strength Index, paper baseline (Opportunity Security Indices pipeline); CC BY 4.0 (the paper's indices)."},{"n":2,"id":"iea_pams","text":"International Energy Agency, Policies and Measures Database (export of 2026-09-30); attribution; https://www.iea.org/policies."},{"n":3,"id":"comtrade_matrix","text":"United Nations, UN Comtrade Database, HS6 bilateral trade (all reporters), 2020 and 2024; reconciled by the authors (pulled 2026-10-07 to 2026-10-09); attribution; https://comtradeplus.un.org/."},{"n":4,"id":"ei","text":"Energy Institute, Statistical Review of World Energy 2026 (data to 2025); attribution; https://www.energyinst.org/statistical-review."},{"n":5,"id":"eia_intl","text":"U.S. Energy Information Administration, International Energy Statistics, bulk file INTL.zip: crude oil incl. lease condensate, NGPL, dry natural gas and coal production; petroleum and other liquids, dry natural gas and coal consumption, bulk file dated 2026-10-03 (oil production to 2025; gas and coal to 2024); open; https://www.eia.gov/international/data/world."},{"n":6,"id":"atlas","text":"Growth Lab at Harvard University, The Atlas of Economic Complexity, HS92 6-digit country-product-year data (data to 2023); attribution; https://atlas.hks.harvard.edu/."},{"n":7,"id":"network","text":"Allied network design (the paper's model design of coalition production shares)."},{"n":8,"id":"cat","text":"Climate Action Tracker, country ratings (ratings updated 2022-2025); attribution; https://climateactiontracker.org/."},{"n":9,"id":"agreements","text":"Economic-security agreements: G7, NATO, Indo-Pacific Economic Framework, Minerals Security Partnership (and Forum), U.S. free-trade agreements (compiled by the authors from official membership lists)."},{"n":10,"id":"un_votes","text":"Bailey, M., Strezhnev, A. and Voeten, E., United Nations General Assembly Voting Data, ideal points (Harvard Dataverse V39.0) (sessions to 2023); attribution; https://dataverse.harvard.edu/dataset.xhtml?persistentId=hdl:1902.1/12379."}],"footer":"Allied Industrial Base Explorer, Country Insights: Portugal"}