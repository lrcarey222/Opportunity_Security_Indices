{
  "name": "allied-industrial-base-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Allied Industrial Base Explorer: an interactive static dashboard of the Opportunity Security Indices paper (NEIS Center).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:fence": "vite --config vite.fence.config.ts",
    "build:fence": "tsc -b && vite build --config vite.fence.config.ts",
    "preview:fence": "vite preview --config vite.fence.config.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit --project ui --project parity-synthetic",
    "test:unit": "vitest run --project unit",
    "test:parity": "vitest run --project parity-real",
    "test:sector-real": "vitest run --project sector-real",
    "test:country-real": "vitest run --project country-real",
    "budget": "node scripts/check-budget.mjs",
    "bench:engine": "vitest run --project parity-real -t performance"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "@observablehq/plot": "0.6.17",
    "@tanstack/react-table": "8.21.3",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "fflate": "0.8.3",
    "katex": "0.16.47",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.5",
    "@types/geojson": "7946.0.16",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
